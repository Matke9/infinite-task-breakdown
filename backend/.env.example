# Local: a plain local Postgres URL. Production (Neon, Path B): use the POOLED
# connection string and keep ?sslmode=require, e.g.
#   postgresql://user:pass@ep-xxxx-pooler.REGION.aws.neon.tech/taskdb?sslmode=require
DATABASE_URL=postgresql://taskuser:password@localhost:5432/taskdb
JWT_SECRET=replace_with_long_random_string
GEMINI_API_KEY=your_gemini_key
PORT=3001
NODE_ENV=development
AI_RATE_LIMIT=20 # optional, default 20

# --- Production (Path B: Render + Neon) ---
# Enable TLS to Postgres (required by Neon). Leave unset/false for local Postgres.
DATABASE_SSL=false
# Run pending migrations at startup (set true on Render — no SSH to run them manually).
RUN_MIGRATIONS_ON_START=false
# CORS allowlist, comma-separated. Unset = allow any origin (fine for local dev).
# In production set to your Cloudflare Pages URL, e.g. https://tasktree.pages.dev
CORS_ORIGIN=
